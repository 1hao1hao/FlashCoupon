# Development only; replace locally. Never commit real credentials.
ADMIN_KEY=replace-with-local-admin-secret
USER_KEY=replace-with-local-user-signing-secret
RATE_LIMIT=5000
TRACING_ENABLED=1
TRACE_SAMPLE_RATIO=0.1
WORKER_CONCURRENCY=20
# Redis HA override only; standalone Compose keeps its original Redis server.
REDIS_MODE=standalone
REDIS_MASTER_NAME=flashcoupon
REDIS_PASSWORD=replace-with-private-redis-secret
REDIS_SENTINEL_PASSWORD=replace-with-private-sentinel-secret
REDIS_HA_PREFIX=172.29.239
REDIS_WAIT_REPLICAS=1
REDIS_WAIT_TIMEOUT_MS=200
# For native k6: REPORT_DIR=reports (Docker k6 defaults to /reports).
# SSH destination and private-network API address are supplied via CLI arguments.
